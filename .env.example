# 数据库连接地址（mysql + aiomysql 异步驱动）
# 格式：mysql+aiomysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+aiomysql://root:password@localhost/recruitment

# JWT 签名密钥（务必替换为足够长的随机字符串，生产环境不要使用示例值）
SECRET_KEY=please-change-me-to-a-long-random-string

# 是否打印 SQL 日志（true/false），生产环境建议设为 false
SQL_ECHO=false

# CORS 允许的来源白名单（逗号分隔），生产环境务必改为真实前端域名
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# 【Docker部署】以下变量仅在 docker compose up 时使用（compose 自动读取本文件/ .env）：
# MySQL 容器 root 密码（仅容器内新库使用，与你本机 MySQL 无关，务必修改）
MYSQL_ROOT_PASSWORD=change-me-docker-mysql-password
